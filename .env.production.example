COMPOSE_PROJECT_NAME=ai-card
IMAGE_REGISTRY=ghcr.io/shibaweidu
IMAGE_TAG=latest

# Use your domain for automatic HTTPS, or :80 for an IP-only deployment.
SITE_ADDRESS=example.com
NEXT_PUBLIC_SITE_URL=https://example.com
WEB_ORIGIN=https://example.com
PUBLIC_API_URL=https://api.example.com/v1
HTTP_PORT=80
HTTPS_PORT=443

POSTGRES_DB=aicard
POSTGRES_USER=aicard
POSTGRES_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql://aicard:replace_with_random_hex@postgres:5432/aicard?connection_limit=10&pool_timeout=10
SLOW_QUERY_MS=300
SEARCH_RATE_LIMIT=120

MEILI_MASTER_KEY=replace_with_at_least_16_random_characters
S3_ACCESS_KEY=aicard
S3_SECRET_KEY=replace_with_at_least_16_random_characters
S3_BUCKET=raw-snapshots
JWT_SECRET=replace_with_at_least_32_random_characters
SUBMISSION_IP_HASH_SECRET=replace_with_a_different_at_least_32_random_characters
WORKER_TOKEN=replace_with_at_least_32_random_characters
BOT_INTERNAL_SECRET=replace_with_at_least_32_random_characters
BOT_HASH_SECRET=replace_with_a_different_at_least_32_random_characters
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false
QQ_APP_ID=
QQ_CLIENT_SECRET=
QQ_BOT_ENABLED=false
GATEWAY_PROBE_ENCRYPTION_KEY=replace_with_64_hex_characters

ENABLE_SOURCE_SCHEDULERS=false
ENABLE_GATEWAY_PROBES=false
PAUSE_SOURCE_JOBS=false
SOURCE_211B_REQUEST_DELAY_MS=3000
SOURCE_211B_ORIGIN=https://2dou.org
CRAWLER_USER_AGENT=AIKawangBot/0.1
ZUIQUANAPI_FEED_URL=
YIPAY_API_URL=https://pay.example.com
YIPAY_PID=
YIPAY_KEY=
YIPAY_TYPE=alipay
